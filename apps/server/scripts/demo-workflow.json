        "evidence": [
          {
            "key": "file",
            "type": "path"
          },
          {
            "key": "total",
            "type": "int",
            "desc": "各公司人数之和"
          },
          {
            "key": "companies",
            "type": "int",
            "desc": "公司个数"
          }
        ],
        "substeps": [
          {
            "id": "s1",
            "title": "读取上游 roster.csv"
          },
          {
            "id": "s2",
            "title": "按公司统计人数"
