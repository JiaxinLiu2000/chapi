# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
# Ports chosen to avoid clashes with other local projects (e.g. one on 3000/8787).
SERVER_PORT=8123
WEB_PORT=3100
# Server binds to localhost only (single-user local deployment)
HOST=127.0.0.1

# ── Database (MySQL) ──────────────────────────────────────────────────────
# Default matches docker-compose.yml (host port 3307 to avoid 3306 clashes)
DATABASE_URL="mysql://chapi:chapi@127.0.0.1:3307/chapi"

# ── Secrets encryption ────────────────────────────────────────────────────
# 32-byte key (hex or base64) used to encrypt API keys stored in the settings table.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_KEY=

# ── Anthropic / Claude Agent SDK ──────────────────────────────────────────
# Required to run the orchestration engine.
ANTHROPIC_API_KEY=
# Default models (can be overridden in Settings UI)
MAIN_MODEL=claude-opus-4-8
SUBAGENT_MODEL=claude-sonnet-4-6

# ── OpenAI (embeddings for RAG) ───────────────────────────────────────────
# Can also be set at runtime via the Settings UI (stored encrypted in DB).
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ── Filesystem roots ──────────────────────────────────────────────────────
WORKSPACES_DIR=./workspaces
SESSIONS_DIR=./sessions
DATA_DIR=./data

# ── Tool sidecars ─────────────────────────────────────────────────────────
CLOAKBROWSER_CDP_PORT=9222
CLOAKBROWSER_PROFILE_DIR=./.browser-profile
# The agent drives cloakbrowser by writing scripts that use the chapi_browser.py
# helper (connect_over_cdp). Set to 1 to ALSO expose the Playwright MCP tools
# (mcp__browser__*) — off by default because its npx startup is slow / can hang.
CHAPI_ENABLE_BROWSER_MCP=
# Extra Chromium args for cloakbrowser (space-separated). Last-resort stability knobs
# for sites that crash the GPU process (heavy WebGL/maps): e.g. "--disable-gpu" or
# "--fingerprint-noise=false". Normally unnecessary — the profile is auto-healed on launch.
CLOAKBROWSER_EXTRA_ARGS=
# Google Workspace OAuth (taylorwilsdon/google_workspace_mcp); can be set in Settings UI
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The Google account the agent operates as (passed as USER_GOOGLE_EMAIL to the MCP)
GOOGLE_USER_EMAIL=joannaliubus@gmail.com
